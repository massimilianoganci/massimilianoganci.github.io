list.files("assets")
list.files("_site/assets")
projects_meta <- list(
list(
dir = "projects/voter-turnout-inla",
title = "Modello Spazio-Temporale per l'Affluenza Elettorale",
subtitle = "Analisi bayesiana con R-INLA"
),
list(
dir = "projects/moldy-fruit-cv",
title = "Riconoscimento Automatico di Frutta Ammuffita",
subtitle = "Computer Vision per il controllo qualità"
),
list(
dir = "projects/portfolio-management",
title = "Data-Driven Portfolio Management",
subtitle = "Allocazione quantitativa e gestione del rischio"
)
)
for (p in projects_meta) {
dir.create(p$dir, recursive = TRUE, showWarnings = FALSE)
content <- c(
"---",
sprintf('title: "%s"', p$title),
sprintf('subtitle: "%s"', p$subtitle),
"---",
"",
"Contenuto del progetto in preparazione."
)
writeLines(content, file.path(p$dir, "index.qmd"))
}
